    <!-- ==================== PHASE 3C HEADER ==================== -->
    <mxCell id="p3c_header" value="PHASE 3C — General Triage Path (Layer 2 + 5 — Bedrock KB + RAG)" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="900" y="700" width="800" height="40" as="geometry" />
    </mxCell>

    <mxCell id="p3c_caller" value="Caller: 'Mere bachche ko 3 din se bukhar hai'" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="960" y="770" width="320" height="50" as="geometry" />
    </mxCell>
    <mxCell id="p3c_nova_lite" value="Nova Lite Extracts:&#xa;is_emergency: false&#xa;condition_id: 'general_fever'&#xa;patient_profile: { category: 'pediatric' }&#xa;clinical_symptoms_english: ['fever', '3 days duration']" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="960" y="850" width="320" height="80" as="geometry" />
    </mxCell>
    <mxCell id="p3c_bedrock_retrieve" value="Bedrock KB Retrieve — LAYER 2+5&#xa;query: 'fever 3 days pediatric treatment'&#xa;filter: { patient_category: 'pediatric' }&#xa;&#xa;Titan Embeddings converts query → vector (~50ms)&#xa;OpenSearch finds closest matching chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="960" y="970" width="360" height="90" as="geometry" />
    </mxCell>
    <mxCell id="p3c_chunks" value="Retrieved Chunks:&#xa;→ WHO IMCI: 'Child fever &gt;3 days: check for malaria,&#xa;   dengue danger signs, give paracetamol for comfort...'&#xa;→ ICMR STW: 'Pediatric fever: ORS if dehydrated,&#xa;   danger signs: convulsions, not drinking, fast breathing...'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1360" y="970" width="320" height="90" as="geometry" />
    </mxCell>
    <mxCell id="p3c_nova_pro" value="Nova Pro (us.amazon.nova-pro-v1:0)&#xa;Receives chunks + generates grounded response:&#xa;'Aapke bachche ko 3 din se bukhar hai.&#xa;Paracetamol 10-15mg/kg de sakte hain.&#xa;ORS pilate rahein. Agar convulsions aaye,&#xa;saans lene mein takleef ho, ya paani na piye&#xa;toh turant PHC jayein.'&#xa;+ AI disclaimer appended&#xa;+ Follow-up: 'Kya bachche ko ulti bhi ho rahi hai?'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="960" y="1100" width="400" height="130" as="geometry" />
    </mxCell>
    <mxCell id="p3c_state_update" value="ConversationState Updated:&#xa;{ turn: 3, triagePath: 'general',&#xa;  conditionId: 'general_fever',&#xa;  patientProfile: { category: 'pediatric' } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1400" y="1100" width="280" height="70" as="geometry" />
    </mxCell>
    <mxCell id="p3c_polly" value="Polly Aditi speaks response&#xa;Caller hears guidance + follow-up question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="960" y="1270" width="280" height="50" as="geometry" />
    </mxCell>

    <mxCell id="e_p3c_caller_nl" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3c_caller" target="p3c_nova_lite" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_p3c_nl_bedrock" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3c_nova_lite" target="p3c_bedrock_retrieve" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_p3c_bedrock_chunks" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3c_bedrock_retrieve" target="p3c_chunks" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_p3c_chunks_np" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3c_chunks" target="p3c_nova_pro" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
