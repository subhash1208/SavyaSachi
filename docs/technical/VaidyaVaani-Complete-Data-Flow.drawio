    <!-- ==================== PHASE 4 HEADER ==================== -->
    <mxCell id="p4_header" value="PHASE 4 — Post-Triage Agentic Actions (AWS Step Functions — ALL PARALLEL)" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
