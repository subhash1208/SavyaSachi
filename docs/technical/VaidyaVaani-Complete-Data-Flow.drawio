    <mxCell id="p4_triage_done" value="Triage Complete&#xa;(any path — 3A, 3B, or 3C)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="540" y="1670" width="200" height="60" as="geometry" />
    </mxCell>
    <mxCell id="p4_sf" value="AWS Step Functions&#xa;Parallel State Machine&#xa;Fires ALL branches simultaneously" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="540" y="1770" width="200" height="60" as="geometry" />
    </mxCell>

    <!-- 5 parallel branches -->
    <mxCell id="p4_b1" value="Branch 1&#xa;Amazon SNS&#xa;SMS to Caller:&#xa;'Fever guidance:&#xa;paracetamol 10-15mg/kg,&#xa;ORS, visit PHC if...'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="1890" width="180" height="110" as="geometry" />
    </mxCell>
    <mxCell id="p4_b2" value="Branch 2&#xa;Call Logger → DynamoDB&#xa;CallRecord {&#xa;  icd10: 'A09',&#xa;  severity: 'urgent',&#xa;  ttl: now+90days,&#xa;  fhirRecord: {...}&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="240" y="1890" width="180" height="110" as="geometry" />
    </mxCell>
    <mxCell id="p4_b3" value="Branch 3&#xa;Follow-Up Scheduler&#xa;Amazon EventBridge&#xa;Schedule callback&#xa;in 2 hours to check&#xa;on child's condition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="440" y="1890" width="180" height="110" as="geometry" />
    </mxCell>
    <mxCell id="p4_b4" value="Branch 4&#xa;Disease Surveillance&#xa;Aggregate:&#xa;general_fever + pediatric&#xa;+ district=Bhopal&#xa;Spike? → Alert DHO&#xa;via QuickSight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="640" y="1890" width="180" height="110" as="geometry" />
    </mxCell>
    <mxCell id="p4_b5" value="Branch 5&#xa;Referral Agent&#xa;Find nearest PHC&#xa;to caller's location&#xa;Include address +&#xa;phone in SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="1890" width="180" height="110" as="geometry" />
    </mxCell>

