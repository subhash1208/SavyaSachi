        for day in weather:
            if (day["temperature"] >= constraints["min_temp"] and 
                day["temperature"] <= constraints["max_temp"] and
                day["humidity"] <= constraints["max_humidity"] and
                day["wind_speed"] <= constraints["max_wind"] and
                day["rain_probability"] <= constraints["max_rain_prob"]):
                suitable_days.append(day)
